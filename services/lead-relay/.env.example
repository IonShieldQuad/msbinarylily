# Copy to .env and fill in. Without TELEGRAM_BOT_TOKEN the relay still stores
# leads and reports telegram: "not-configured" on /status.
PORT=8080
DB_PATH=./leads.sqlite3

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email copy (Yandex: smtp.yandex.ru, port 465, app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# Only this origin may POST to the relay
ALLOW_ORIGIN=https://ionshieldquad.github.io
RATE_LIMIT_PER_HOUR=5
# Daily "alive" ping to Telegram
DAILY_PING=false
